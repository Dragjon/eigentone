<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Phonons" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#141516</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="WidgetButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/widget_button</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textColor">#EEEEEA</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
